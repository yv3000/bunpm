{
  "name": "bunpm",
  "version": "2.0.4",
  "private": true,
  "description": "Zero-runtime-dependency npm, npx, yarn and pnpm wrapper for Bun",
  "type": "commonjs",
  "license": "MIT",
  "repository": "https://github.com/yv3000/bunpm.git",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "node scripts/syntax.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:repeat": "node scripts/repeat.js",
    "test:coverage": "node scripts/coverage.js",
    "smoke": "node --test tests/smoke.test.js",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "syntax:check": "node scripts/syntax.js",
    "typecheck": "tsc -p jsconfig.json",
    "audit": "npm audit --audit-level=high",
    "shell:check": "shellcheck bunpm/platforms/linux/scripts/*.sh bunpm/platforms/macos/scripts/*.sh bunpm/platforms/linux/bin/* bunpm/platforms/macos/bin/*"
  },
  "devDependencies": {
    "@types/node": "16.18.126",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
