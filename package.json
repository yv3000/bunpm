{
  "name": "bunpm",
  "version": "2.3.9",
  "private": true,
  "description": "Zero-runtime-dependency npm, npx, yarn and pnpm wrapper for Bun",
  "type": "commonjs",
  "keywords": [
    "cli",
    "bun",
    "npm",
    "yarn",
    "pnpm",
    "package-manager",
    "wrapper"
  ],
  "license": "MIT",
  "bin": {
    "bunpm": "bunpm/core/wrapper.js"
  },
  "author": "Yash <191557828+yv3000@users.noreply.github.com>",
  "homepage": "https://github.com/yv3000/bunpm#readme",
  "bugs": {
    "url": "https://github.com/yv3000/bunpm/issues"
  },
  "repository": "https://github.com/yv3000/bunpm.git",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "node scripts/syntax.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:unit": "node --test tests/core.test.js tests/mapper.test.js tests/validation.test.js tests/schema.test.js tests/log.test.js",
    "test:repeat": "node scripts/repeat.js",
    "test:coverage": "c8 node --test \"tests/*.test.js\"",
    "coverage:check": "c8 check-coverage",
    "smoke": "node --test tests/installer.test.js tests/installer-unix.test.js tests/smoke.test.js",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "syntax:check": "node scripts/syntax.js",
    "typecheck": "tsc -p jsconfig.json",
    "audit": "npm audit --audit-level=high && bun audit --audit-level=high",
    "freshness": "node scripts/check-freshness.js",
    "check-no-skips": "node scripts/check-no-skips.js tests/smoke.test.js",
    "shell:check": "shellcheck bunpm/platforms/linux/scripts/*.sh bunpm/platforms/macos/scripts/*.sh bunpm/platforms/linux/bin/* bunpm/platforms/macos/bin/*"
  },
  "testConfig": {
    "framework": "node:test",
    "coverage": "c8",
    "configFiles": [
      ".c8rc.json",
      "jsconfig.json"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "16.18.126",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
