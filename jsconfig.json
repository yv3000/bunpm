{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": ["bunpm/**/*.js", "scripts/*.js"]
}
