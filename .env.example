# Reference only: export selected values in your shell or CI, not this whole file.
# Node.js entry points do not load .env; Bun may auto-load it when running tests.

# Overrides the GitHub raw URL for local testing; downloaded code is executed.
# Default: https://raw.githubusercontent.com/yv3000/bunpm/main/bunpm
# Use only trusted HTTP(S) sources. Local example: http://localhost:8000
# file:///path/to/bunpm is NOT supported; serve that directory over HTTP instead:
# python3 -m http.server 8000 --directory /path/to/bunpm
BUNPM_REPO_BASE=https://raw.githubusercontent.com/yv3000/bunpm/main/bunpm

# Executable lookup and installer PATH updates; defaults to your inherited OS PATH.
# Do not replace your PATH with this example; keep the existing entries.
PATH=/usr/local/bin:/usr/bin:/bin

# Unix home for staging, installation and shell profiles; default is your OS home.
# os.homedir() also reads HOME on Unix. Leave your real HOME unchanged.
HOME=/home/your-user

# Windows home for staging and installation; default is your Windows user profile.
# os.homedir() also reads USERPROFILE on Windows. Leave your real profile unchanged.
USERPROFILE=C:\Users\your-user

# Fallback npm executable path when constructing the child environment.
# Default: unset; normally replaced with the detected Bun executable path.
npm_execpath=/usr/local/lib/node_modules/npm/bin/npm-cli.js

# Used by the documented Windows download command, not read by bunpm itself.
# Default: your Windows temporary directory, usually %USERPROFILE%\AppData\Local\Temp.
TEMP=C:\Users\your-user\AppData\Local\Temp
