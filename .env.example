# .env.example
# bunpm requires zero secrets, tokens, or custom runtime configuration.
# The only environment variables referenced by the wrapper are read-only
# and provided directly by the operating system:

# PATH: Read-only, provided by the OS/shell to discover Bun and original package manager binaries.
PATH=

# WINDIR / SystemRoot: Read-only on Windows, provided by the OS to locate cmd.exe for batch shims.
WINDIR=
# BUNPM_DEBUG: Optional. Set to 1 to add one JSON line per bunpm diagnostic on stderr.
BUNPM_DEBUG=
